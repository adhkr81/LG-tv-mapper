# Serial port configuration (LG)
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# Path where USB screenshots land on your PC (optional - for watch mode)
USB_WATCH_PATH=

# Server port
PORT=3001

# Projects live under server/src/data/projects/<id>/
# (emulator.json, mapper-meta.json, screenshots/)

# Samsung RMUS remote-management portal
RMUS_USERNAME=
RMUS_PASSWORD=
# RMUS_BASE_URL=https://rmus.samsungcsportal.com/RemoteControl#none
# RMUS_LOGIN_URL=https://rmus.samsungcsportal.com/
# RMUS_STORAGE_STATE_PATH=./server/src/data/.cache/rmus-storage-state.json
# RMUS_HEADLESS=0
