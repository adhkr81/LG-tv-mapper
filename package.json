{
  "name": "lg-emulator-mapper",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"wait-on tcp:127.0.0.1:3001 && npm run dev:client\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
